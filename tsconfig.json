{
  "include": ["portal/**/*.ts", "portal/**/*.tsx"],
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strictNullChecks": true
  }
}
